<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- The window is painted the VAS ground before Compose draws, so a cold start never flashes white. -->
    <style name="Theme.VadosGallery" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/ground</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>
</resources>
